{
  "name": "rehabinated",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Home rehab coach: camera joint tracking, rep counting, set scoring and daily streaks.",
  "scripts": {
    "vendor": "node scripts/vendor-assets.mjs",
    "predev": "node scripts/vendor-assets.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/vendor-assets.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json",
    "test": "vitest run",
    "synthetic": "vite-node scripts/synthetic-data.ts --"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "onnxruntime-web": "1.20.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
